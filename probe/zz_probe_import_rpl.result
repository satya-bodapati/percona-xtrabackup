include/rpl/init_source_replica.inc
Warnings:
Note	####	Sending passwords in plain text without SSL/TLS is extremely insecure.
Note	####	Storing MySQL user name or password information in the connection metadata repository is not secure and is therefore not recommended. Please consider using the USER and PASSWORD connection options for START REPLICA; see the 'START REPLICA Syntax' in the MySQL Manual for more information.
[connection master]
CREATE TABLE t1 (id INT PRIMARY KEY, a INT) ENGINE=InnoDB;
INSERT INTO t1 VALUES (1,1),(2,2);
CREATE TABLE t2 (id INT PRIMARY KEY, a INT) ENGINE=InnoDB;
INSERT INTO t2 VALUES (1,1),(2,2);
FLUSH TABLES t1, t2 FOR EXPORT;
UNLOCK TABLES;
DROP TABLE t1;
ALTER TABLE t2 DISCARD TABLESPACE;
include/rpl/sync_to_replica.inc
#### A. IMPORT TABLE FROM .ibd, file placed on the source only
IMPORT TABLE FROM 'test/t1.ibd';
SHOW BINLOG EVENTS FROM 1608;
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
SELECT * FROM t1;
id	a
1	1
2	2
include/rpl/sync_to_replica.inc
# replica after sync:
SHOW TABLES;
Tables_in_test
t2
#### B. ALTER TABLE IMPORT TABLESPACE, file placed on the source only
ALTER TABLE t2 IMPORT TABLESPACE;
SHOW BINLOG EVENTS FROM 1608;
Log_name	Pos	Event_type	Server_id	End_log_pos	Info
#	#	Anonymous_Gtid	1	#	SET @@SESSION.GTID_NEXT= 'ANONYMOUS'
#	#	Query	1	#	use `test`; ALTER TABLE t2 IMPORT TABLESPACE /* xid=211 */
SELECT LAST_ERROR_NUMBER, LAST_ERROR_MESSAGE FROM performance_schema.replication_applier_status_by_worker WHERE LAST_ERROR_NUMBER <> 0;
LAST_ERROR_NUMBER	LAST_ERROR_MESSAGE
1812	Worker 1 failed executing transaction 'ANONYMOUS' at source log master-bin.000001, end_log_pos 1805; Error 'Tablespace is missing for table `test`.`t2`.' on query. Default database: 'test'. Query: 'ALTER TABLE t2 IMPORT TABLESPACE'
# put the file on the replica too and resume
START REPLICA SQL_THREAD;
include/rpl/sync_to_replica.inc
SELECT * FROM t2;
id	a
1	1
2	2
#### C. Same file placed on both, IMPORT TABLE on the source
DROP TABLE t2;
include/rpl/sync_to_replica.inc
IMPORT TABLE FROM 'test/t2.ibd';
INSERT INTO t2 VALUES (3,3);
SELECT LAST_ERROR_NUMBER, LAST_ERROR_MESSAGE FROM performance_schema.replication_applier_status_by_worker WHERE LAST_ERROR_NUMBER <> 0;
LAST_ERROR_NUMBER	LAST_ERROR_MESSAGE
1146	Worker 1 failed executing transaction 'ANONYMOUS' at source log master-bin.000001, end_log_pos 2274; Error 'Table 'test.t2' doesn't exist' on query. Default database: 'test'. Query: 'INSERT INTO t2 VALUES (3,3)'
SHOW TABLES;
Tables_in_test
t2.ibd
