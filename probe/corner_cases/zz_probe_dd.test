--source include/have_innodb_16k.inc
--disable_abort_on_error
let $D = `SELECT @@datadir`;
let $T = $MYSQL_TMP_DIR/zzd;
--mkdir $T

--echo ##### D1: the FK parent was recreated with another column type
CREATE TABLE p (id INT PRIMARY KEY);
CREATE TABLE c (id INT PRIMARY KEY, pid INT, CONSTRAINT fkc FOREIGN KEY (pid) REFERENCES p (id) ON DELETE CASCADE);
INSERT INTO p VALUES (1),(2);
INSERT INTO c VALUES (10,1),(20,2);
FLUSH TABLES c FOR EXPORT;
--copy_file $D/test/c.ibd $T/c.ibd
UNLOCK TABLES;
DROP TABLE c, p;
CREATE TABLE p (id VARCHAR(10) PRIMARY KEY);
INSERT INTO p VALUES ('1'),('2');
--copy_file $T/c.ibd $D/test/c.ibd
IMPORT TABLE FROM 'test/c.ibd';
SHOW CREATE TABLE c;
INSERT INTO c VALUES (30, 3);
INSERT INTO c VALUES (40, 1);
DELETE FROM p WHERE id = '1';
SELECT * FROM c ORDER BY id;
DROP TABLE IF EXISTS c;
DROP TABLE p;
--remove_files_wildcard $D/test c.ibd

--echo ##### D2: the FK parent was recreated without an index on the column
CREATE TABLE p (id INT, v INT, KEY kv (v));
INSERT INTO p VALUES (1,1),(2,2);
--copy_file $T/c.ibd $D/test/c.ibd
IMPORT TABLE FROM 'test/c.ibd';
SHOW CREATE TABLE c;
INSERT INTO c VALUES (30, 3);
DELETE FROM p WHERE id = 1;
SELECT * FROM c ORDER BY id;
DROP TABLE IF EXISTS c;
DROP TABLE p;
--remove_files_wildcard $D/test c.ibd

--echo ##### D3: the FK name is taken by another table of the schema
CREATE TABLE p (id INT PRIMARY KEY);
CREATE TABLE other (id INT PRIMARY KEY, pid INT, CONSTRAINT fkc FOREIGN KEY (pid) REFERENCES p (id));
--copy_file $T/c.ibd $D/test/c.ibd
IMPORT TABLE FROM 'test/c.ibd';
SHOW TABLES;
DROP TABLE IF EXISTS c;
DROP TABLE other, p;
--remove_files_wildcard $D/test c.ibd

--echo ##### D4: the CHECK constraint name is taken by another table
CREATE TABLE ck (a INT, CONSTRAINT chk1 CHECK (a > 0));
INSERT INTO ck VALUES (5);
FLUSH TABLES ck FOR EXPORT;
--copy_file $D/test/ck.ibd $T/ck.ibd
UNLOCK TABLES;
DROP TABLE ck;
CREATE TABLE other (b INT, CONSTRAINT chk1 CHECK (b > 0));
--copy_file $T/ck.ibd $D/test/ck.ibd
IMPORT TABLE FROM 'test/ck.ibd';
SHOW TABLES;
DROP TABLE IF EXISTS ck;
DROP TABLE other;
--remove_files_wildcard $D/test ck.ibd

--echo ##### D5: the spatial reference system no longer exists
CREATE SPATIAL REFERENCE SYSTEM 4000001 NAME 'TEST4000001 Long-Lat WGS 84' DEFINITION 'GEOGCS["Long-Lat WGS 84",DATUM["World Geodetic System 1984",SPHEROID["WGS 84",6378137,298.257223563,AUTHORITY["EPSG","7030"]],AUTHORITY["EPSG","6326"]],PRIMEM["Greenwich",0,AUTHORITY["EPSG","8901"]],UNIT["degree",0.017453292519943278,AUTHORITY["EPSG","9122"]],AXIS["Lon",EAST],AXIS["Lat",NORTH],AUTHORITY["EPSG","4326"]]';
CREATE TABLE g (id INT PRIMARY KEY, pt POINT NOT NULL SRID 4000001, SPATIAL INDEX sp (pt));
INSERT INTO g VALUES (1, ST_GeomFromText('POINT(1 1)', 4000001)), (2, ST_GeomFromText('POINT(5 5)', 4000001));
FLUSH TABLES g FOR EXPORT;
--copy_file $D/test/g.ibd $T/g.ibd
UNLOCK TABLES;
DROP TABLE g;
DROP SPATIAL REFERENCE SYSTEM 4000001;
--copy_file $T/g.ibd $D/test/g.ibd
IMPORT TABLE FROM 'test/g.ibd';
SHOW CREATE TABLE g;
SELECT id, ST_AsText(pt) FROM g ORDER BY id;
SELECT id FROM g FORCE INDEX (sp) WHERE MBRContains(ST_GeomFromText('POLYGON((0 0,0 3,3 3,3 0,0 0))', 4000001), pt);
INSERT INTO g VALUES (3, ST_GeomFromText('POINT(2 2)', 4000001));
DROP TABLE IF EXISTS g;
--remove_files_wildcard $D/test g.ibd

--echo ##### D6: an INSTANT column default with a charset/collation, and a GIPK table
SET sql_generate_invisible_primary_key = ON;
CREATE TABLE gk (a INT, s VARCHAR(10) COLLATE utf8mb4_bin);
INSERT INTO gk (a, s) VALUES (1,'x'),(2,'y');
SET sql_generate_invisible_primary_key = OFF;
FLUSH TABLES gk FOR EXPORT;
--copy_file $D/test/gk.ibd $T/gk.ibd
UNLOCK TABLES;
DROP TABLE gk;
--copy_file $T/gk.ibd $D/test/gk.ibd
IMPORT TABLE FROM 'test/gk.ibd';
SET show_gipk_in_create_table_and_information_schema = ON;
SHOW CREATE TABLE gk;
SELECT my_row_id, a, s FROM gk ORDER BY my_row_id;
INSERT INTO gk (a, s) VALUES (3, 'z');
SELECT my_row_id, a FROM gk ORDER BY my_row_id;
DROP TABLE gk;

--echo ##### D7: two tables; the second fails after the first was converted
CREATE TABLE aaa (id INT PRIMARY KEY);
INSERT INTO aaa VALUES (1);
FLUSH TABLES aaa FOR EXPORT;
--copy_file $D/test/aaa.ibd $T/aaa.ibd
UNLOCK TABLES;
DROP TABLE aaa;
--copy_file $T/aaa.ibd $D/test/aaa.ibd
--copy_file $T/c.ibd $D/test/c.ibd
IMPORT TABLE FROM 'test/aaa.ibd', 'test/c.ibd';
--list_files $D/test
SHOW TABLES;
DROP TABLE IF EXISTS aaa, c;
--remove_files_wildcard $D/test *.ibd
--force-rmdir $T
