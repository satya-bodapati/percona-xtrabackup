--source include/have_innodb_16k.inc
--source include/have_debug.inc
--disable_abort_on_error
let $D = `SELECT @@datadir`;
let $T = $MYSQL_TMP_DIR/zzf2;
--mkdir $T

--echo ##### F11: a FULLTEXT auxiliary table file, imported on its own
CREATE TABLE f (id INT PRIMARY KEY, b TEXT, FULLTEXT KEY fb (b));
INSERT INTO f VALUES (1,'hello world'),(2,'quick brown fox');
SET GLOBAL innodb_buf_flush_list_now = 1;
let $aux = `SELECT SUBSTRING(PATH, 3) FROM information_schema.INNODB_DATAFILES WHERE PATH LIKE '%fts%config.ibd' LIMIT 1`;
let $idx = `SELECT SUBSTRING(PATH, 3) FROM information_schema.INNODB_DATAFILES WHERE PATH LIKE '%fts%index_1.ibd' LIMIT 1`;
--copy_file $D/$aux $T/aux.ibd
--copy_file $D/$idx $T/idx.ibd
DROP TABLE f;
--copy_file $T/aux.ibd $D/$aux
--copy_file $T/idx.ibd $D/$idx
--replace_regex /fts_[0-9a-f_]*/fts_X_/
eval IMPORT TABLE FROM '$aux';
--replace_regex /fts_[0-9a-f_]*/fts_X_/
eval IMPORT TABLE FROM '$idx';
SHOW TABLES;
--remove_files_wildcard $D/test fts_*

--echo ##### F13: names that need encoding
CREATE TABLE `t-1 ñ` (id INT PRIMARY KEY);
INSERT INTO `t-1 ñ` VALUES (7);
let $enc = `SELECT SUBSTRING(PATH, 3) FROM information_schema.INNODB_DATAFILES WHERE PATH LIKE './test/t@%'`;
FLUSH TABLES `t-1 ñ` FOR EXPORT;
--copy_file $D/$enc $T/enc.ibd
UNLOCK TABLES;
DROP TABLE `t-1 ñ`;
--copy_file $T/enc.ibd $D/$enc
eval IMPORT TABLE FROM '$enc';
SELECT * FROM `t-1 ñ`;
DROP TABLE IF EXISTS `t-1 ñ`;

--echo ##### F15: a live table's file copied while the server runs (no FLUSH FOR EXPORT)
CREATE TABLE hot (id INT PRIMARY KEY, a INT);
INSERT INTO hot VALUES (1,1),(2,2);
SET GLOBAL innodb_buf_flush_list_now = 1;
ALTER TABLE hot ADD COLUMN c INT DEFAULT 7, ALGORITHM=INSTANT;
INSERT INTO hot VALUES (3,3,3);
--copy_file $D/test/hot.ibd $T/hot_before.ibd
SET GLOBAL innodb_buf_flush_list_now = 1;
--copy_file $D/test/hot.ibd $T/hot_after.ibd
DROP TABLE hot;
--copy_file $T/hot_before.ibd $D/test/hot.ibd
IMPORT TABLE FROM 'test/hot.ibd';
SELECT * FROM hot ORDER BY id;
DROP TABLE IF EXISTS hot;
--remove_files_wildcard $D/test hot.ibd
--copy_file $T/hot_after.ibd $D/test/hot.ibd
IMPORT TABLE FROM 'test/hot.ibd';
SELECT * FROM hot ORDER BY id;
DROP TABLE IF EXISTS hot;
--remove_files_wildcard $D/test hot.ibd
--force-rmdir $T
