ERROR HY000: Schema mismatch ('/home/satya/WORK/ps/ps-8.4-import-refactor/bld/mysql-test/var/1/mysqld.1/data/test/pt#p#zz.ibd' is not a tablespace file of `test`.`pt`)
SELECT * FROM pt ORDER BY id;
ERROR 42S02: Table 'test.pt' doesn't exist
pt#p#p0.ibd
pt#p#p1.ibd
pt#p#p2.ibd
pt#p#zz.ibd
DROP TABLE IF EXISTS pt;
Warnings:
Note	1051	Unknown table 'test.pt'
##### P4c: p1 named twice through two patterns, p2 not named
IMPORT TABLE FROM 'test/pt#p#p0.ibd', 'test/pt#p#p1.ibd', 'test/pt#p#p?.ibd';
SELECT * FROM pt ORDER BY id;
id	v
1	a
2	b
11	k
12	l
21	u
DROP TABLE IF EXISTS pt;
