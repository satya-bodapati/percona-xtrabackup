CREATE DATABASE db2;
CREATE TABLE pt (id INT PRIMARY KEY, v VARCHAR(20)) PARTITION BY RANGE (id)
(PARTITION p0 VALUES LESS THAN (10), PARTITION p1 VALUES LESS THAN (20),
PARTITION p2 VALUES LESS THAN MAXVALUE);
INSERT INTO pt VALUES (1,'a'),(2,'b'),(11,'k'),(12,'l'),(21,'u');
FLUSH TABLES pt FOR EXPORT;
UNLOCK TABLES;
DROP TABLE pt;
##### P1: files of p0 and p1 swapped
IMPORT TABLE FROM 'test/pt#p#*.ibd';
ERROR HY000: Schema mismatch ('/home/satya/WORK/ps/ps-8.4-import-refactor/bld/mysql-test/var/1/mysqld.1/data/test/pt#p#p0.ibd' holds partition `p1` of `test`.`pt`, not partition `p0` of `test`.`pt`)
SELECT * FROM pt ORDER BY id;
ERROR 42S02: Table 'test.pt' doesn't exist
SELECT * FROM pt WHERE id = 11;
ERROR 42S02: Table 'test.pt' doesn't exist
pt#p#p0.ibd
pt#p#p1.ibd
pt#p#p2.ibd
DROP TABLE IF EXISTS pt;
Warnings:
Note	1051	Unknown table 'test.pt'
##### P4: p2 renamed to a name that is no partition (pt#p#zz)
IMPORT TABLE FROM 'test/pt#p#p0.ibd', 'test/pt#p#p1.ibd', 'test/pt#p#zz.ibd';
ERROR HY000: Schema mismatch ('/home/satya/WORK/ps/ps-8.4-import-refactor/bld/mysql-test/var/1/mysqld.1/data/test/pt#p#zz.ibd' is not a tablespace file of `test`.`pt`)
SELECT * FROM pt ORDER BY id;
ERROR 42S02: Table 'test.pt' doesn't exist
pt#p#p0.ibd
pt#p#p1.ibd
pt#p#zz.ibd
DROP TABLE IF EXISTS pt;
Warnings:
Note	1051	Unknown table 'test.pt'
##### P4b: names p0, p1, zz; the real p2 file is present but not named
